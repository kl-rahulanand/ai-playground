# Copy this file to `.env` and set ONE credential. `.env` is gitignored.
#
#   cp .env.example .env
#
# --- Option A: OAuth token from your Claude subscription (no API credit needed) ---
# Generate one with:  claude setup-token
# Paste the result here. Sentinel sends it as a Bearer token with the
# oauth-2025-04-20 beta header. Uses your Pro/Max subscription, not API billing.
# NOTE: subscription tokens only reach claude-haiku-4-5 on the direct Messages
# API — Sonnet/Opus return a 429 on that path.
ANTHROPIC_AUTH_TOKEN=

# --- Option B: a real API key from https://console.anthropic.com ---
# The Developer Console / API, billed per token, separate from your subscription.
# Add a few dollars of credit under Billing or calls return "credit balance too low".
# If both are set, the API key wins. A real key can use opus-5 / sonnet-5 below.
ANTHROPIC_API_KEY=

# Endpoint. Leave as the default unless you route through a gateway.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Which model Sentinel uses. With an OAuth token, keep claude-haiku-4-5.
# With a real API key you may set claude-opus-5 or claude-sonnet-5.
SENTINEL_MODEL=claude-haiku-4-5

# Default output-token ceiling. A LIMIT, not a target length.
SENTINEL_MAX_TOKENS=8000
